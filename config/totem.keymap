//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define DEV  3
#define NUM  4
#define ACCENT 5

// Hyper = cmd+ctrl+alt+shift, Meh = ctrl+alt+shift.
// No app claims these, so they are safe for global hotkeys.
#define HYP LS(LC(LA(LGUI)))
#define MEH LS(LC(LALT))

// TOTEM key positions, 0-37, in keymap order.
#define KEYS_L  0  1  2  3  4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R  5  6  7  8  9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        // Timeless home row mods, per urob / ZMK docs.
        // A mod only fires on cross-hand or thumb follow-ups, and never
        // mid-typing-stream. Same-hand rolls always resolve as taps.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    macros {
        // macOS dead keys: option+e = acute, option+` = grave,
        // option+i = circumflex, option+u = trema. The first four emit a
        // finished character; the last two arm the dead key and leave the
        // vowel to you, so one key covers every vowel.
        //
        // Requires the Mac's keyboard type to be ANSI -- if it is set to
        // ISO, option+` produces a literal section sign instead of arming
        // the grave dead key. System Settings > Keyboard > Change Keyboard Type.
        fr_e_acute: fr_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(E)>, <&macro_tap &kp E>;
        };

        fr_e_grave: fr_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp E>;
        };

        fr_a_grave: fr_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp A>;
        };

        fr_u_grave: fr_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp U>;
        };

        fr_circumflex: fr_circumflex {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I)>;
        };

        fr_trema: fr_trema {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // F + J together -> caps lock. Base layer only, so it cannot fire
        // while a layer is held. Short timeout to avoid catching fast typing.
        combo_caps {
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            key-positions = <13 16>;   // F and J
            bindings = <&kp CAPS>;
            layers = <BASE>;
        };

        // Z + X together -> sticky accent layer: the combo fires and
        // releases, then the very next key comes from the accent layer.
        // "zx" is not a digraph in French or English, and both are plain
        // keys, so there is no hold-tap to fight with.
        combo_accent {
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            key-positions = <21 22>;   // Z and X
            bindings = <&sl ACCENT>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Mods, weakest finger outward: ctrl - alt - cmd - shift
        // Cmd sits on the middle finger because it is the most used
        // modifier on macOS. Ctrl is on the pinky because it is the least.
        //
        // The num key had no tap action, so it now taps ctrl+alt+w for
        // Wispr Flow dictation -- one key here instead of a three key
        // chord, since the firmware sends the modifiers itself.
        base {
            bindings = <
        &kp Q         &kp W        &kp E        &kp R         &kp T      &kp Y      &kp U         &kp I        &kp O        &kp P
        &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G      &kp H      &hmr RSHFT J  &hmr RGUI K  &hmr RALT L  &hmr RCTRL SEMI
&lt NUM LC(LA(W)) &kp Z   &kp X        &hml MEH C   &hml HYP V    &kp B      &kp N      &hmr HYP M    &hmr MEH COMMA &kp DOT    &kp FSLH        &kp APOS
                                   &lt SYM ESC   &lt NAV SPACE  &mt LGUI TAB &kp RET    &kp BSPC      &kp DEL
            >;
        };

        // Left hand keeps the arrow cluster so it stays usable one-handed
        // with the right hand on the trackpad. Right home row carries plain
        // mods, so cmd+arrow and cmd+shift+arrow work by chording across hands.
        // Bottom row carries all four navigation shortcuts, off the pinky:
        // x/c step back and forward through history, v/b step through tabs.

        nav {
            bindings = <
             &kp HOME     &kp BACKSPACE  &kp UP     &kp DELETE  &kp PG_UP     &none   &none      &none     &none     &none
             &kp END      &kp LEFT       &kp DOWN   &kp RIGHT   &kp PG_DN     &none   &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL
&none        &none        &kp LG(LBKT) &kp LG(RBKT) &kp LG(LS(LBKT)) &kp LG(LS(RBKT))  &none  &none  &none  &none  &none  &none
                                         &trans     &trans      &trans        &none   &none      &none
            >;
        };

        sym_func {
            bindings = <
           &none          &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LS(LA(N2))    &none             &kp F1   &kp F2   &kp F3   &kp F4   &kp F5
           &none          &kp LBKT              &kp RBKT               &kp ENTER         &kp BSLH          &kp F6   &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL
&kp GRAVE  &none          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none             &kp UNDERSCORE    &kp F7   &kp F8     &kp F9    &kp F10   &kp F11   &kp F12
                                                &trans                 &trans            &trans            &none    &none    &none
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        // Numpad, held with the left outer pinky. Left home row carries plain
        // mods so cmd+digit and shift+digit work while the layer is held.
        num {
            bindings = <
        &none      &none      &none      &none      &none       &kp N5      &kp N6    &kp N7     &kp N8    &kp N9
        &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &none       &kp N0      &kp N1    &kp N2     &kp N3    &kp N4
&trans  &none      &none      &none      &none      &none       &kp PERIOD  &kp PLUS  &kp MINUS  &kp STAR  &kp FSLH  &kp CARET
                              &none      &none      &none       &kp EQUAL   &none     &kp PERCENT
            >;
        };

        // Reached by the Z+X combo as a sticky layer, so every accent is
        // one chord followed by one tap -- no holds. Letters sit on their
        // own keys (e -> e-acute, a -> a-grave...). y and i arm a bare dead
        // key instead, so one key covers every vowel it applies to.
        accent {
            bindings = <
&trans       &trans  &fr_e_acute  &trans      &trans   &fr_trema  &fr_u_grave  &fr_circumflex  &trans  &trans
&fr_a_grave  &trans  &fr_e_grave  &trans      &trans   &trans     &trans       &trans          &trans  &trans
&trans       &trans  &trans       &kp LA(C)   &trans   &trans     &trans       &trans          &trans  &trans  &trans  &trans
                                  &trans      &trans   &trans     &trans       &trans          &trans
            >;
        };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <NAV SYM>;
            then-layer = <DEV>;
        };
    };
};
