//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

// Pointer speed. Firmware default is 600, which crawls; scroll's default 10
// was too slow on-device and 25 too fast.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900
#define ZMK_POINTING_DEFAULT_SCRL_VAL 16
#include <dt-bindings/zmk/pointing.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define DEV  4
#define FN   5
#define ACCENT 6
#define MOUSE   7
#define PRECISE 8
#define SCROLL  9
#define FAST    10

// Hyper = cmd+ctrl+alt+shift, Meh = ctrl+alt+shift.
// No app claims these, so they are safe for global hotkeys.
#define HYP LS(LC(LA(LGUI)))
#define MEH LS(LC(LALT))

// TOTEM key positions, 0-37, in keymap order.
#define KEYS_L  0  1  2  3  4 10 11 12 13 14 20 21 22 23 24 25
#define KEYS_R  5  6  7  8  9 15 16 17 18 19 26 27 28 29 30 31
#define THUMBS 32 33 34 35 36 37

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    // 300 gives an easy tap-then-hold window for auto-repeating tab
    // (cmd+tab cycling). Only the tab thumb uses &mt.
    quick-tap-ms = <300>;
};

// Ramp to full pointer speed over half a second, so a short tap nudges a few
// pixels and a held key crosses the screen. exponent 1 = linear ramp.
// &msc is left at its defaults, which already do not accelerate.
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
};

/ {
    behaviors {
        // A second pointer instance with acceleration switched off, used only
        // by the precise tier: a ramped "precise" barely moves on a tap, so
        // its 150 must land on the first report. Fast deliberately does NOT
        // use this -- a flat fast next to a ramped normal feels 4x+ faster
        // during the ramp window even at a 2.2x ceiling, so fast rides the
        // same ramped &mmv as normal and differs only in ceiling.
        // exponent 0 makes time-to-max-speed-ms inert; it matches the shape
        // ZMK ships for &msc.
        mmv_flat: mmv_flat {
            compatible = "zmk,behavior-input-two-axis";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <300>;
            acceleration-exponent = <0>;
        };

        // Timeless home row mods, per urob / ZMK docs.
        // A mod only fires on cross-hand or thumb follow-ups, and never
        // mid-typing-stream. Same-hand rolls always resolve as taps.
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    // A two-axis behavior emits movement onto its own virtual input device;
    // without a listener routing that device into the HID pipeline the events
    // go nowhere and the keys silently do nothing -- precise/fast pressed
    // fine and moved nothing. ZMK pairs its built-in &mmv with exactly this
    // node (app/dts/behaviors/mouse_move.dtsi); a second instance needs its
    // own.
    mmv_flat_input_listener {
        compatible = "zmk,input-listener";
        device = <&mmv_flat>;
    };

    macros {
        // Click and leave the pointer layer in one tap. This is the mouse
        // layer's default right-thumb click, mirroring neru's own default,
        // Space = ["action left_click", "idle"]. Staying in mode is the
        // exception, reached by holding scroll, the left thumb's middle
        // position (see the scroll layer, which overrides these three
        // positions back to a plain, non-exiting &mkp) -- neru's own
        // exception is the same shape, Shift+Space = "action left_click"
        // with no idle. Release before the layer change, or the button
        // sticks.
        lclk_exit: lclk_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &mkp LCLK>, <&macro_tap &to BASE>;
        };

        rclk_exit: rclk_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &mkp RCLK>, <&macro_tap &to BASE>;
        };

        mclk_exit: mclk_exit {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &mkp MCLK>, <&macro_tap &to BASE>;
        };

        // Drag lock. macro_press holds the button without releasing it, so both
        // hands stay free to move and scroll mid-drag; drag_off drops it. Only
        // worth reaching for on long drags -- holding the LCLK thumb and moving
        // with the same hand's fingers is a real drag already.
        drag_on: drag_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mkp LCLK>;
        };

        drag_off: drag_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_release &mkp LCLK>;
        };

        // macOS dead keys via option (e=acute, `=grave, i=circumflex, u=trema).
        // Needs keyboard type = ANSI, else option+` sends a section sign.
        fr_e_acute: fr_e_acute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(E)>, <&macro_tap &kp E>;
        };

        fr_e_grave: fr_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp E>;
        };

        fr_a_grave: fr_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp A>;
        };

        fr_u_grave: fr_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(GRAVE)>, <&macro_tap &kp U>;
        };

        fr_circumflex: fr_circumflex {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(I)>;
        };

        fr_trema: fr_trema {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LA(U)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // F + J together -> caps lock. Base layer only, so it cannot fire
        // while a layer is held. Short timeout to avoid catching fast typing.
        combo_caps {
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            key-positions = <13 16>;   // F and J
            bindings = <&kp CAPS>;
            layers = <BASE>;
        };

        // z + x -> sticky accent layer. Not a digraph, both keys plain.
        combo_accent {
            timeout-ms = <40>;
            require-prior-idle-ms = <120>;
            key-positions = <21 22>;   // Z and X
            bindings = <&sl ACCENT>;
            layers = <BASE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Mods, weakest finger outward: ctrl - alt - cmd - shift
        // Cmd sits on the middle finger because it is the most used
        // modifier on macOS. Ctrl is on the pinky because it is the least.
        // num key taps ctrl+alt+w for Wispr Flow (its hotkey caps at 3 keys).
        base {
            bindings = <
        &kp Q         &kp W        &kp E        &kp R         &kp T      &kp Y      &kp U         &kp I        &kp O        &kp P
        &hml LCTRL A  &hml LALT S  &hml LGUI D  &hml LSHFT F  &kp G      &kp H      &hmr RSHFT J  &hmr RGUI K  &hmr RALT L  &hmr RCTRL SEMI
&lt FN LC(LA(W))  &kp Z   &kp X        &hml MEH C   &hml HYP V    &kp B      &kp N      &hmr HYP M    &hmr MEH COMMA &kp DOT    &kp FSLH        &none
                                   &lt NUM ESC   &lt NAV SPACE  &mt LGUI TAB &kp RET    &kp BSPC      &lt SYM DEL
            >;
        };

        // Left hand keeps arrows usable one-handed with the right hand on
        // the trackpad; right home row carries plain mods for cmd+arrow.
        // x/c = history back/forward, v/b = prev/next tab. Device reuses
        // x/c for rewind/fast-forward.
        //
        // y triggers neru's jump grid on hyper+y (the chord matches the key),
        // so no app can claim it. It lives here rather than on the mouse
        // layer on purpose: nav is a hold layer, so releasing the thumb drops
        // back to base, where the grid's qwert/asdfg/cvbnm/yuiop/hjkl; keys
        // actually exist. On a toggled layer those positions are pointer keys
        // and the grid is dead. The grid is the only thing neru is still used
        // for; scrolling is the mouse layer's job now.
        // h toggles the pointer layer, which is a mode, not a hold.
        //
        // Right thumbs send shift+enter/backspace: with the grid open, the
        // plain thumbs click-and-exit (neru binds Enter/Backspace), and
        // holding this nav thumb turns the same thumbs into click-and-stay --
        // the identical gesture to the mouse layer's scroll-hold clicks.
        nav {
            bindings = <
             &kp HOME     &kp BACKSPACE  &kp UP     &kp DELETE  &kp PG_UP     &kp LS(LC(LA(LG(Y))))  &none  &none  &none  &none
             &kp END      &kp LEFT       &kp DOWN   &kp RIGHT   &kp PG_DN     &tog MOUSE   &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL
&none        &kp LG(GRAVE) &kp LG(LBKT) &kp LG(RBKT) &kp LG(LS(LBKT)) &kp LG(LS(RBKT))  &none  &none      &none     &none     &none      &none
                                         &trans     &trans      &trans        &kp LS(RET)  &kp LS(BSPC)  &none
            >;
        };

        num {
            bindings = <
           &kp LS(LA(N2)) &kp LEFT_BRACE        &kp RIGHT_BRACE        &none             &none             &kp N1      &kp N2    &kp N3     &kp N4    &kp N5
           &none          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none             &none             &kp N6      &kp N7    &kp N8     &kp N9    &kp N0
&none      &none          &kp LBKT              &kp RBKT               &none             &none             &kp MINUS   &kp EQUAL &kp APOS   &kp GRAVE   &kp BSLH  &none
                                                &none                  &trans            &trans            &none       &none     &trans
            >;
        };

        // Shifted mirror of num, same positions. Own thumb-hold on Del
        // (tap Del, hold Sym), independent of whether num is also held.
        sym {
            bindings = <
        &none      &none            &none             &none              &none    &kp EXCLAMATION  &kp AT_SIGN     &kp HASH  &kp DOLLAR  &kp PERCENT
        &none      &none            &none             &none              &none    &kp CARET        &kp AMPERSAND   &kp ASTERISK  &none                 &none
&none      &none              &none    &none             &none              &none    &kp UNDERSCORE   &kp PLUS        &kp DOUBLE_QUOTES  &kp TILDE      &kp PIPE      &none
                                     &trans           &trans            &trans   &trans           &trans          &trans
            >;
        };

        device {
            bindings = <
       &none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &kp C_RW              &kp C_FF              &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        // Function keys, held with the left outer pinky. Left home row carries
        // plain mods so cmd+f-key and shift+f-key work while the layer is held.
        fn {
            bindings = <
        &none      &none      &none      &none      &none       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
        &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &none       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &none      &none      &none      &none      &none       &kp F11 &kp F12 &none   &none   &none   &none
                              &none      &none      &none       &none   &none   &none
            >;
        };

        // Reached via the z+x sticky combo: one chord, one tap, no holds.
        // i/y arm the circumflex/trema dead keys instead of a fixed letter.
        accent {
            bindings = <
&trans       &trans  &fr_e_acute  &trans      &trans   &fr_trema  &fr_u_grave  &fr_circumflex  &trans  &trans
&fr_a_grave  &trans  &fr_e_grave  &trans      &trans   &trans     &trans       &trans          &trans  &trans
&trans       &trans  &trans       &kp LA(C)   &trans   &trans     &trans       &trans          &trans  &trans  &trans  &trans
                                  &trans      &trans   &trans     &trans       &trans          &trans
            >;
        };

        // Firmware pointer, arranged after miryoku's mouse layer: one hand owns
        // the pointer, the other owns the modifiers, so every modified action
        // is a cross-hand chord and nothing contorts.
        //
        // Miryoku's rule is that mouse movement mirrors cursor navigation, and
        // nav here is left-handed, so the pointer is too: move on e/s/d/f, the
        // exact inverted-T nav uses for arrows.
        //
        // Clicks are on the right thumbs, left/right/middle outward from
        // center: left click nearest the fingers since it is the one held for
        // drag, middle click outermost since it is rarest. They exit the
        // layer by default -- aim, click, done, mirroring neru's own default
        // (Space = ["action left_click", "idle"]). Holding scroll (the left
        // thumb's middle position) and clicking is the exception that stays
        // in mode, mirroring neru's Shift+Space (click with no idle) -- see
        // the scroll layer, which overrides these three positions back to a
        // plain, non-exiting &mkp. Esc is dropped: it was only reachable one
        // thumb at a time anyway, since scroll occupies the thumb Esc used
        // to sit on.
        //
        // Left thumbs are slow / scroll / fast, one hold each -- a single
        // thumb only ever does one job at a time, so scroll lives on its own
        // thumb rather than a separate key on row3. See precise/scroll/fast
        // below for why each is a held layer rather than a modifier.
        //
        // Right home row is plain mods, same order as base. That is what makes
        // ctrl+scroll (zoom in Figma and browsers), shift+click, and cmd+click
        // work without the pointer hand leaving home position.
        //
        // Miryoku holds this layer with an opposite-hand thumb; all three left
        // thumbs are already committed here, so it stays a toggle off nav's h,
        // exited from the same position.
        mouse {
            bindings = <
        &none      &none           &mmv MOVE_UP    &none            &none      &none    &none    &none     &none     &none
        &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none      &to BASE &kp RSHFT &kp RGUI  &kp RALT  &kp RCTRL
&trans  &drag_on   &drag_off       &none           &none            &none      &none    &none     &none     &none     &none      &none
                                   &mo PRECISE     &mo SCROLL       &mo FAST   &lclk_exit  &rclk_exit  &mclk_exit
            >;
        };

        // Speed tiers on e/s/d/f, held from the left thumbs' outer two
        // positions. Held layers rather than mod-morphs for the same reason
        // as scroll: a real modifier would cost mod+drag.
        //
        // &mmv_flat, not &mmv: no ramp, so the value lands on the first
        // report. That is the whole point of a tier -- a ramped tier is just
        // the normal key with a different ceiling.
        precise {
            bindings = <
        &trans  &trans                  &mmv_flat MOVE_Y(-150)   &trans                  &trans   &trans  &trans  &trans  &trans  &trans
        &trans  &mmv_flat MOVE_X(-150)  &mmv_flat MOVE_Y(150)    &mmv_flat MOVE_X(150)   &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                  &trans                   &trans                  &trans   &trans  &trans  &trans  &trans  &trans  &trans
                                        &trans                   &trans                  &trans   &trans  &trans  &trans
            >;
        };

        // Held from the left thumb's middle position -- physically between
        // precise and fast, but this is not a speed tier: e/s/d/f becomes
        // scroll, not a third move speed. It does two jobs on one thumb
        // rather than splitting them across two keys:
        //
        // 1. Scroll on the same e/s/d/f as move. Everything else falls
        //    through, so the mouse layer's mods stay live -- shift+scroll is
        //    still horizontal scroll, ctrl+scroll is still zoom. Page up/down
        //    on t/g, the same column nav uses for its own PG_UP/PG_DN below
        //    UP/DOWN; mouse leaves that column &none, so this is scroll-only.
        //    The SCRL_* bindings are deliberately crossed (the up key sends
        //    SCRL_DOWN, etc.): macOS natural scrolling flips wheel input on
        //    both axes, and this cancels it so keys move the viewport the
        //    way they point.
        //    t/g are page-jump wheel bursts, not &kp PG_UP/PG_DN: PG keys act
        //    on the focused window, wheel events on the window under the
        //    cursor, and everything else in this mode follows the cursor.
        //
        // 2. The right thumbs override back to plain, non-exiting clicks:
        //    hold scroll (you are mid-navigation, finding the thing to
        //    click) and tap a click, and it fires without dropping you out
        //    of mouse mode -- left-thumb hold, right-thumb tap, a genuine
        //    cross-hand chord. A held layer rather than a mod-morph here too:
        //    a morph would need a real HID modifier, disturbing the right
        //    home row's shift/cmd/ctrl/alt click meaning.
        scroll {
            bindings = <
        &trans  &trans            &msc SCRL_DOWN   &trans            &msc MOVE_Y(-120)  &trans  &trans  &trans  &trans  &trans
        &trans  &msc SCRL_RIGHT   &msc SCRL_UP     &msc SCRL_LEFT    &msc MOVE_Y(120)   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans            &trans           &trans            &trans      &trans  &trans     &trans     &trans     &trans  &trans
                                  &trans           &trans            &trans      &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        fast {
            bindings = <
        &trans  &trans              &mmv MOVE_Y(-2000)  &trans              &trans   &trans  &trans  &trans  &trans  &trans
        &trans  &mmv MOVE_X(-2000)  &mmv MOVE_Y(2000)   &mmv MOVE_X(2000)   &trans   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans                   &trans                   &trans                   &trans   &trans  &trans  &trans  &trans  &trans  &trans
                                         &trans                   &trans                   &trans   &trans  &trans  &trans
            >;
        };

        // Spare for adding a layer live in ZMK Studio. Reserved layers are not
        // status-okay, so this does not shift any layer index above.
        extra8 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <NAV NUM>;
            then-layer = <DEV>;
        };
    };
};
